[run]
source = .
omit = 
    */tests/*
    */venv/*
    */site-packages/*
    setup.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    pass
    raise ImportError
    except ImportError:

[html]
directory = htmlcov
title = TheTraitors Test Coverage 